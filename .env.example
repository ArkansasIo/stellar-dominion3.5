# Runtime
NODE_ENV=development
PORT=5001
VITE_API_URL=

# PostgreSQL / Drizzle
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_dominion

# Sessions
SESSION_SECRET=replace-with-a-long-random-secret

# CORS
CORS_ORIGINS=http://localhost:5001,http://localhost:5173

# Optional game tuning
GAME_TICK_INTERVAL_MS=30000
RESOURCE_PRODUCTION_MULTIPLIER=1
RESEARCH_SPEED_MULTIPLIER=1
BUILD_SPEED_MULTIPLIER=1
